DROP TABLE IF EXISTS mf200.crisil_nifty500_fund_master;

CREATE TABLE mf200.crisil_nifty500_fund_master AS
SELECT
    ROW_NUMBER() OVER (ORDER BY "schemeName") AS fund_id,
    "schemeName" AS scheme_name,
    category,
    category_name,
    subcategory_id,
    subcategory_name,
    MIN(report_date) AS first_report_date,
    MAX(report_date) AS last_report_date
FROM mf200.crisil_fund_daily_raw
WHERE benchmark = 'Nifty 500 TRI'
GROUP BY
    "schemeName",
    category,
    category_name,
    subcategory_id,
    subcategory_name;

